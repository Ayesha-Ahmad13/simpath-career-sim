# SimPath environment variables
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# SimPath currently runs entirely on mock data, so no variables are required
# to run or deploy the site. The entries below are placeholders for when a
# real backend / AI service is connected later.

# Public (browser-visible) values must be prefixed with VITE_
# VITE_APP_URL=https://simpath-career-sim.lovable.app

# Server-only secrets (never prefixed with VITE_)
# AI_API_KEY=
